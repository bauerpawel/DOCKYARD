<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t['meta_title'] }}</title>
<meta name="description" content="{{ t['meta_description'] }}">
<meta name="author" content="Paweł Bauer">
<meta name="theme-color" content="#14181a">
{% if site_url %}
<link rel="canonical" href="{{ site_url }}/">
<link rel="alternate" hreflang="x-default" href="{{ site_url }}/">
{% for language in languages %}
<link rel="alternate" hreflang="{{ language.code }}" href="{{ site_url }}/{{ language.query }}">
{% endfor %}
{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Dockyard">
<meta property="og:title" content="{{ t['meta_title'] }}">
<meta property="og:description" content="{{ t['meta_description'] }}">
{% if site_url %}
<meta property="og:url" content="{{ site_url }}/">
<meta property="og:image" content="{{ site_url }}/static/dockyard-social-preview.png">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site_url }}/static/dockyard-social-preview.png">
{% else %}
<meta name="twitter:card" content="summary">
{% endif %}
<meta name="twitter:title" content="{{ t['meta_title'] }}">
<meta name="twitter:description" content="{{ t['meta_description'] }}">
<script type="application/ld+json">{{ structured_data|tojson }}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Allerta+Stencil&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="static/style.css">
<link rel="icon" type="image/svg+xml" href="static/dockyard-mark.svg">
<script defer src="https://umami.bauer.net.pl/script.js" data-website-id="59bcd7b8-03ad-439b-b2d4-e29cf809c449"></script>
<script defer src="https://umami.bauer.net.pl/recorder.js" data-website-id="59bcd7b8-03ad-439b-b2d4-e29cf809c449"></script>
</head>
<body>

<div class="hazard-bar" aria-hidden="true"></div>

<header class="site-head">
  <div class="wrap">
    <nav class="lang-switch" aria-label="{{ t['lang_label'] }}" data-i18n-aria-label="lang_label">
      {% for language in languages %}
      <a href="{{ language.href }}" hreflang="{{ language.code }}" lang="{{ language.code }}" data-lang="{{ language.code }}" title="{{ language.name }}"{% if language.code == "en" %} aria-current="true"{% endif %}>{{ language.code|upper }}</a>
      {% endfor %}
    </nav>
    <p class="eyebrow" data-i18n="eyebrow">{{ t['eyebrow'] }}</p>
    <div class="wordmark-row">
      <svg class="wordmark-icon" viewBox="0 0 100 100" aria-hidden="true">
        <mask id="wordmark-hole"><rect width="100" height="100" fill="#fff"/><circle cx="23" cy="50" r="7" fill="#000"/></mask>
        <g mask="url(#wordmark-hole)">
          <path d="M8,50 L44,14 L79,14 A13,13 0 0 1 92,27 L92,73 A13,13 0 0 1 79,86 L44,86 Z" fill="#ff7a29"/>
        </g>
      </svg>
      <h1 class="wordmark">DOCKYARD</h1>
    </div>
    <p class="tagline" data-i18n="tagline">{{ t['tagline'] }}</p>
  </div>
</header>

<section class="wrap">
  <div class="ticket">
    <span class="ticket-label" data-i18n="ticket_label">{{ t['ticket_label'] }}</span>
    <div class="ticket-row">
      <code id="feed-url">{{ templates_feed_url }}</code>
      <button id="copy-btn" type="button" data-i18n="copy">{{ t['copy'] }}</button>
    </div>
    <p class="ticket-hint">Portainer → Settings → App Templates → URL</p>
  </div>
  <p class="repo-link"><a href="{{ repo_url }}" target="_blank" rel="noopener">{% if repo_on_github %}<svg class="repo-mark" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>{% endif %}<span>{{ repo_label }}</span></a></p>
</section>

<section class="controls wrap">
  <input id="search" type="search" placeholder="{{ t['search_placeholder'] }}" aria-label="{{ t['search_label'] }}" data-i18n-placeholder="search_placeholder" data-i18n-aria-label="search_label">
  <div class="chips" id="chips">
    <button class="chip is-active" type="button" data-category="all"><span data-i18n="all">{{ t['all'] }}</span> ({{ apps|length }})</button>
    {% for cat, count in categories %}
    <button class="chip" type="button" data-category="{{ cat }}"><span class="chip-label">{{ cat }}</span> ({{ count }})</button>
    {% endfor %}
  </div>
</section>

<main class="grid wrap" id="grid">
  {% for app in apps %}
  <article class="tag" data-name="{{ app.name|lower }}" data-category="{{ app.category }}">
    <span class="tag-hole" aria-hidden="true"></span>
    <span class="stamp stamp-{{ app.type }}">{{ "Container" if app.type == "container" else "Compose" }}</span>
    <div class="tag-head tag-toggle" role="button" tabindex="0" aria-expanded="false" title="{{ t['expand_hint'] }}">
      <span class="logo-frame"><img class="logo" src="{{ app.logo|image_url }}" alt="" loading="lazy" width="36" height="36"></span>
      <div>
        <h2 class="tag-title">{{ app.name }}</h2>
        <span class="badge">{{ app.category }}</span>
      </div>
    </div>
    <p class="tag-desc tag-toggle" role="button" tabindex="0" aria-expanded="false" title="{{ t['expand_hint'] }}">{{ app.description }}</p>
    <div class="tag-links">
      {% if app.docker_hub_url|web_url %}<a href="{{ app.docker_hub_url|web_url }}" target="_blank" rel="noopener">Docker Hub ▸</a>{% endif %}
      {% if app.website|web_url %}<a class="source-link" href="{{ app.website|web_url }}" target="_blank" rel="noopener">{{ t['source'] }}</a>{% endif %}
    </div>
  </article>
  {% endfor %}
</main>

<p class="empty-state" id="empty-state" data-i18n="empty" hidden>{{ t['empty'] }}</p>

<footer class="site-foot">
  <div class="wrap">
    <p><span data-i18n="footer_built_a">{{ t['footer_built_a'] }}</span> <code>apps/*.yaml</code><span data-i18n="footer_built_b">{{ t['footer_built_b'] }}</span></p>
    <p><span data-i18n="footer_made">{{ t['footer_made'] }}</span> Paweł Bauer — <a href="https://bauer.net.pl" target="_blank" rel="noopener">bauer.net.pl</a></p>
    <p><span data-i18n="footer_repo">{{ t['footer_repo'] }}</span> <a href="{{ repo_url }}">{{ repo_url }}</a></p>
  </div>
</footer>

<script type="application/json" id="i18n">{{ i18n|tojson }}</script>
<script src="static/app.js"></script>
</body>
</html>
