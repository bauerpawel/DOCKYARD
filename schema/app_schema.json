{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOCKYARD app definition",
  "type": "object",
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "type": {"enum": ["container", "compose"]},
    "logo": {"type": "string", "minLength": 1},
    "image": {"type": ["string", "null"]},
    "compose": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "website": {"type": ["string", "null"]},
    "network": {"type": ["string", "null"]},
    "command": {"type": ["string", "null"]},
    "privileged": {"type": ["boolean", "null"]},
    "repository": {
      "type": ["object", "null"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "stackfile": {"type": "string", "minLength": 1}
      },
      "required": ["url", "stackfile"]
    },
    "ports": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1}
    },
    "env": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "label": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]},
          "default": {"type": ["string", "null"]},
          "preset": {"type": ["boolean", "null"]},
          "select": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["text", "value"],
              "properties": {
                "text": {"type": "string"},
                "value": {"type": "string"},
                "default": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "volumes": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["container"],
        "properties": {
          "container": {"type": "string", "minLength": 1},
          "bind": {"type": ["string", "null"]},
          "readonly": {"type": ["boolean", "null"]}
        }
      }
    }
  },
  "required": ["name", "slug", "category", "type", "logo"]
}
