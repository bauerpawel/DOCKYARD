# Adres katalogu (bez nazwy pliku): https://TWOJA-DOMENA/mcp/
# Działa, gdy Apache pozwala na .htaccess (AllowOverride FileInfo).
# Żądanie POST nie może dostać zewnętrznego przekierowania 301/302.

Options -Indexes -MultiViews
DirectorySlash Off

# JSON-RPC, błędy i strona HTML nie mogą iść do cache. Brak nagłówka
# pozwala pośrednikowi dołożyć własne max-age (widziane jako 14400).
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
</IfModule>

# Feed schodzi z oficjalnego CDN i leży 15 minut w cache/ (opis w INSTRUKCJA.md). Inny adres feedu:
# SetEnv DOCKYARD_TEMPLATES_URL https://cdn.jsdelivr.net/gh/OWNER/REPO@main/templates.json

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bez tego /mcp (bez slasha) omija reguły poniżej i kończy się 404.
    RewriteOptions AllowNoSlash

    RewriteRule ^(?:cache(?:/|$)|vendor(?:/|$)|guide(?:/|$)|composer\.(?:json|lock)$|templates\.json$|AGENT\.md$|INSTRUKCJA\.md$|apache\.conf$|\.gitignore$) - [F,END]

    RewriteRule ^index\.php$ - [END]
    RewriteRule ^$ index.php [END]
    RewriteRule . index.php [END]
</IfModule>
